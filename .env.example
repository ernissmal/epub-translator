OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EPUB_TRANSLATOR_MODEL=gpt-4o-mini
EPUB_TRANSLATOR_FILL_MODEL=
EPUB_TRANSLATOR_TOKEN_ENCODING=o200k_base
EPUB_TRANSLATOR_CONCURRENCY=2
EPUB_TRANSLATOR_RETRY_TIMES=5
EPUB_TRANSLATOR_MAX_UPLOAD_BYTES=104857600
EPUB_TRANSLATOR_DATA_DIR=/tmp/epub-translator
